{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fellwise.co.uk/events/catalogue.experience.published.v2.schema.json",
  "title": "catalogue.experience.published v2 payload",
  "description": "An experience went live, or its live content changed. Consumers upsert at the envelope's aggregate_version.",
  "x-event-name": "catalogue.experience.published",
  "x-event-version": 2,
  "type": "object",
  "properties": {
    "experience_id": {
      "$ref": "#/$defs/ulid"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "region_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 40
    },
    "guide_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/ulid"
        },
        {
          "type": "null"
        }
      ]
    },
    "price_display": {
      "$ref": "#/$defs/money"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "experience_id",
    "slug",
    "title",
    "region_id",
    "guide_id",
    "price_display",
    "published_at"
  ],
  "additionalProperties": false,
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "money": {
      "type": "object",
      "description": "Money as integer minor units (pence). Never a float.",
      "properties": {
        "amount_minor": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "amount_minor",
        "currency"
      ],
      "additionalProperties": false
    }
  }
}
