{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fellwise.co.uk/events/bookings.availability.changed.v1.schema.json",
  "title": "bookings.availability.changed v1 payload",
  "description": "Places left on one departure of an experience changed.",
  "x-event-name": "bookings.availability.changed",
  "x-event-version": 1,
  "type": "object",
  "properties": {
    "experience_id": {
      "$ref": "#/$defs/ulid"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "remaining_slots": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "experience_id",
    "date",
    "remaining_slots"
  ],
  "additionalProperties": false,
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    }
  }
}
